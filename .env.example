# Environment Configuration for Mobile App
#
# Copy to .env and adjust for your machine. The EXPO_PUBLIC_ prefix is required
# for a variable to be inlined into the client bundle.
#
# All values are optional. Development automatically uses localhost:8001 on
# iOS/web and 10.0.2.2:8001 on an Android emulator. Release builds use the
# production host.

# Development backend.
# Leave these commented to use the platform-aware emulator defaults. For a
# physical device, replace 192.168.1.10 with this laptop's current LAN IP and
# start Django on 0.0.0.0:8001 so the phone can reach it.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8001/api
# EXPO_PUBLIC_WS_BASE_URL=ws://192.168.1.10:8001
# EXPO_PUBLIC_MEDIA_BASE_URL=http://192.168.1.10:8001
# Public website used for share links. Until a separate landing site is
# deployed, this can point to the same host as the backend.
# EXPO_PUBLIC_WEB_BASE_URL=http://192.168.1.10:8001

# Production API URL
EXPO_PUBLIC_PRODUCTION_API_URL=https://api.daremelive.com/api
EXPO_PUBLIC_PRODUCTION_WS_BASE_URL=wss://api.daremelive.com
EXPO_PUBLIC_PRODUCTION_MEDIA_BASE_URL=https://api.daremelive.com
EXPO_PUBLIC_PRODUCTION_WEB_BASE_URL=https://daremelive.com
