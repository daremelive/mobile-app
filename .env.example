# Environment Configuration for Mobile App
#
# Copy to .env and adjust for your machine. The EXPO_PUBLIC_ prefix is required
# for a variable to be inlined into the client bundle.
#
# All values are optional: src/config/env.ts falls back to localhost:8000 in
# development and to the production host in release builds.

# Development backend.
# localhost works for the iOS simulator and Android emulator and survives
# network changes. For a physical device, use this machine's LAN IP
# (`ipconfig getifaddr en0`) and start Django with
# `python manage.py runserver 0.0.0.0:8000` so it accepts LAN connections.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8000
EXPO_PUBLIC_MEDIA_BASE_URL=http://localhost:8000

# Production API URL
EXPO_PUBLIC_PRODUCTION_API_URL=https://api.daremelive.com/api
